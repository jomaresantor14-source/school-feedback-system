<%- include('partials/head', { title: 'Track a submission' }) %>
<%- include('partials/public-nav') %>

<main id="main" class="container container--narrow page tracking-page">
    <div class="page-head">
        <h1>Track a submission</h1>
        <p class="lede lede--sm">Enter the reference code you received after submitting. Dashes and letter case do not matter.</p>
    </div>

    <form class="card form form--inline" action="/feedback/track" method="GET">
        <div class="field">
            <label for="code">Reference code</label>
            <input class="input input--code" type="text" id="code" name="code" value="<%= code %>" placeholder="9B5F-485A-7549-2EE0" autocomplete="off" autocapitalize="characters" spellcheck="false" required>
        </div>
        <button type="submit" class="btn btn--primary btn--lg">Check status</button>
    </form>

    <% if (searched && !feedback) { %>
        <div class="alert alert--error" role="alert">
            <%- icon('alert', 18) %>
            <span>No submission matches that code. Check for a typo and try again.</span>
        </div>
    <% } %>

    <% if (feedback) {
        const visibleUpdates = updates.slice().reverse();
        const recentUpdates = visibleUpdates.slice(0, 5);
        const earlierUpdates = visibleUpdates.slice(5);
    %>
        <article class="card result tracking-result">
            <header class="tracking-summary">
                <div class="tracking-summary__title">
                    <h2><%= feedback.subject %></h2>
                    <p class="muted">Reference <%= formatRef(feedback.reference_code) %></p>
                </div>
                <%- include('partials/status-badge', { badgeStatus: feedback.status_name }) %>
                <p class="tracking-summary__updated">
                    Last updated <%= fmtDate(feedback.last_updated_at) %>
                    <% if (feedback.status_name === 'Resolved' && resolvedIn) { %>
                        <span>Resolved in <%= resolvedIn %></span>
                    <% } %>
                </p>
            </header>

            <section class="tracking-progress" aria-label="Submission progress">
                <ol class="stepper tracking-stepper">
                    <% steps.forEach((step, index) => {
                        const stepClass = index < currentStepIndex ? 'is-done' : (index === currentStepIndex ? 'is-current' : '');
                    %>
                        <li class="<%= stepClass %>"<%- index === currentStepIndex ? ' aria-current="step"' : '' %>>
                            <span class="stepper__dot"></span>
                            <span class="stepper__label"><%= step %></span>
                            <span class="visually-hidden">Step <%= index + 1 %> of <%= steps.length %>: <%= step %></span>
                        </li>
                    <% }) %>
                </ol>
            </section>

            <% if (response) { %>
                <section class="tracking-response" aria-label="Latest response">
                    <div class="tracking-response__heading">
                        <h3>Response from <%= response.sender_role %></h3>
                        <time datetime="<%= new Date(response.changed_at).toISOString() %>"><%= fmtDate(response.changed_at) %></time>
                    </div>
                    <p><%= response.message %></p>
                </section>
            <% } %>

            <section class="tracking-updates" aria-labelledby="tracking-updates-title">
                <h3 id="tracking-updates-title">Updates</h3>
                <% if (!visibleUpdates.length) { %>
                    <p class="muted">No updates are available yet.</p>
                <% } %>

                <ol class="tracking-update-list">
                    <% let currentDay = ''; %>
                    <% recentUpdates.forEach(item => {
                        const day = fmtDate(item.changed_at, false);
                        if (day !== currentDay) {
                            currentDay = day;
                    %>
                        <li class="tracking-update-list__day"><h4><%= day %></h4></li>
                    <% } %>
                        <li class="tracking-update">
                            <time class="tracking-update__time" datetime="<%= new Date(item.changed_at).toISOString() %>"><%= new Date(item.changed_at).toLocaleTimeString('en-PH', { timeZone: 'Asia/Manila', hour: 'numeric', minute: '2-digit' }) %></time>
                            <span class="timeline__dot <%= item.type === 'note' ? 'timeline__dot--note' : 'timeline__dot--' + statusClass(item.status_name) %>"></span>
                            <div class="tracking-update__content">
                                <p class="tracking-update__label"><%= item.label %></p>
                                <% if (item.type === 'note') { %><p class="timeline__note"><%= item.remarks %></p><% } %>
                            </div>
                        </li>
                    <% }) %>
                </ol>

                <% if (earlierUpdates.length) { %>
                    <details class="tracking-earlier">
                        <summary>Show earlier updates (<%= earlierUpdates.length %>)</summary>
                        <ol class="tracking-update-list">
                            <% currentDay = ''; %>
                            <% earlierUpdates.forEach(item => {
                                const day = fmtDate(item.changed_at, false);
                                if (day !== currentDay) {
                                    currentDay = day;
                            %>
                                <li class="tracking-update-list__day"><h4><%= day %></h4></li>
                            <% } %>
                                <li class="tracking-update">
                                    <time class="tracking-update__time" datetime="<%= new Date(item.changed_at).toISOString() %>"><%= new Date(item.changed_at).toLocaleTimeString('en-PH', { timeZone: 'Asia/Manila', hour: 'numeric', minute: '2-digit' }) %></time>
                                    <span class="timeline__dot <%= item.type === 'note' ? 'timeline__dot--note' : 'timeline__dot--' + statusClass(item.status_name) %>"></span>
                                    <div class="tracking-update__content">
                                        <p class="tracking-update__label"><%= item.label %></p>
                                        <% if (item.type === 'note') { %><p class="timeline__note"><%= item.remarks %></p><% } %>
                                    </div>
                                </li>
                            <% }) %>
                        </ol>
                    </details>
                <% } %>
                <p class="tracking-updates__note">Internal workflow steps are hidden from this page.</p>
            </section>

            <section class="tracking-submission" aria-labelledby="tracking-submission-title">
                <h3 id="tracking-submission-title">Your submission</h3>
                <dl class="facts tracking-submission__facts">
                    <div><dt>Type</dt><dd><%= feedback.feedback_type %></dd></div>
                    <div><dt>Category</dt><dd><%= feedback.category_name %></dd></div>
                    <div><dt>Handled by</dt><dd><%= feedback.department_name || 'Waiting to be assigned' %></dd></div>
                    <div><dt>Submitted</dt><dd><%= fmtDate(feedback.created_at) %></dd></div>
                </dl>
                <h4>Description</h4>
                <p class="prose"><%= feedback.description %></p>
            </section>
        </article>
    <% } %>
</main>

<%- include('partials/public-footer') %>
<%- include('partials/foot') %>
