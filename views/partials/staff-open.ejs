<%
    const role = user.role;
    const deptStaff = DEPT_ROLES.includes(role);
    const path = currentUrl.split('?')[0];
    const query = new URLSearchParams(currentUrl.split('?')[1] || '');
    const onUnassigned = query.get('department') === 'unassigned';
    const items = [{ href: '/staff/dashboard', label: 'Dashboard', icon: 'dashboard' }];
    const feedbackType = String(query.get('feedback_type') || '');

    if (role === 'admin') {
        items.push(
            { href: '/feedback/admin?status_name=Pending', label: 'New / Pending Feedback', icon: 'inbox', statusName: 'Pending' },
            { href: '/feedback/admin?department=unassigned', label: 'Unassigned Feedback', icon: 'list', unassigned: true },
            { href: '/feedback/admin?status_name=Assigned', label: 'Assign to Department', icon: 'users', statusName: 'Assigned' },
            { href: '/feedback/admin?status_name=Awaiting+Admin+Review', label: 'Awaiting Admin Review', icon: 'eye', statusName: 'Awaiting Admin Review' },
            { href: '/feedback/admin?status_name=Awaiting+Admin+Review', label: 'Approve Resolution', icon: 'check', statusName: 'Awaiting Admin Review' }
        );
    }
    if (role === 'faculty') {
        items[0].label = 'Faculty Dashboard';
        items.push(
            { href: '/feedback/department-inbox', label: 'Assigned Feedback', icon: 'inbox', inbox: true },
            { href: '/feedback/department-inbox?feedback_type=Concern', label: 'Faculty Concerns', icon: 'alert', feedbackType: 'Concern' },
            { href: '/feedback/department-inbox?feedback_type=Suggestion', label: 'Faculty Suggestions', icon: 'plus', feedbackType: 'Suggestion' },
            { href: '/feedback/department-inbox?status_name=Awaiting+Admin+Review', label: 'Submitted to Admin', icon: 'send', statusName: 'Awaiting Admin Review' },
            { href: '/feedback/department-history', label: 'Feedback History', icon: 'chart', history: true },
            { href: '/staff/profile', label: 'My Profile', icon: 'user' }
        );
    } else if (deptStaff) {
        items.push(
            { href: '/feedback/department-inbox', label: 'Inbox', icon: 'inbox', inbox: true },
            { href: '/feedback/department-inbox?status_name=Under+Review', label: 'Under Review', icon: 'eye', statusName: 'Under Review' },
            { href: '/feedback/department-inbox?status_name=In+Progress', label: 'In Progress', icon: 'list', statusName: 'In Progress' },
            { href: '/feedback/department-inbox?status_name=Awaiting+Admin+Review', label: 'Submit for Final Review', icon: 'send', statusName: 'Awaiting Admin Review' },
            { href: '/feedback/department-history', label: 'Feedback History for Their Department', icon: 'chart', history: true }
        );
    }
    if (role === 'institutional_management') items.push({ href: '/feedback/management', label: 'School overview', icon: 'eye' });
    if (role === 'admin') items.push({ href: '/staff/reports', label: 'Reports and Analytics', icon: 'chart' });
    else if (role === 'institutional_management' || deptStaff) items.push({ href: '/staff/reports', label: 'Reports', icon: 'chart' });

    if (role === 'admin') items.push({ href: '/auth/create-staff', label: 'Staff accounts', icon: 'users' });
%>
<div class="app">
    <aside class="sidebar<%= role === 'faculty' ? ' sidebar--faculty' : '' %>">
        <a class="brand brand--light" href="/staff/dashboard"><%- include('brand') %></a>

        <nav class="side-nav" aria-label="Staff">
            <% items.forEach(item => {
                const current = item.unassigned
                    ? path.startsWith('/feedback/admin') && onUnassigned
                    : item.statusName
                        ? path === item.href.split('?')[0] && query.get('status_name') === item.statusName
                    : item.inbox
                        ? path === item.href && !query.has('status_name') && !feedbackType
                        : item.feedbackType
                            ? path === item.href.split('?')[0] && feedbackType === item.feedbackType
                            : item.history
                                ? path === item.href
                                : path === item.href;
            %>
                <a href="<%= item.href %>"<%- current ? ' aria-current="page"' : '' %>>
                    <%- icon(item.icon, 18) %><span><%= item.label %></span>
                </a>
            <% }) %>
            <% if (role === 'faculty') { %>
                <form class="side-nav__logout-form" action="/auth/logout" method="POST">
                    <%- include('csrf') %>
                    <button type="submit" class="side-nav__logout">
                        <%- icon('logout', 18) %><span>Logout</span>
                    </button>
                </form>
            <% } %>
        </nav>

        <div class="side-user">
            <span class="avatar" aria-hidden="true"><%= initials(user.full_name) %></span>
            <span class="side-user__text">
                <strong><%= user.full_name %></strong>
                <small><%= roleLabel(user.role) %></small>
            </span>
            <% if (role !== 'faculty') { %>
                <form action="/auth/logout" method="POST">
                    <%- include('csrf') %>
                    <button type="submit" class="icon-btn" title="Log out" aria-label="Log out"><%- icon('logout', 18) %></button>
                </form>
            <% } %>
        </div>
    </aside>

    <main class="app-main" id="main">