
<%
    const role = user.role;
    const deptStaff = DEPT_ROLES.includes(role);
    const path = currentUrl.split('?')[0];
    const query = new URLSearchParams(currentUrl.split('?')[1] || '');
    const onUnassigned = query.get('department') === 'unassigned';

    const items = [
        { href: '/staff/dashboard', label: 'Dashboard', icon: 'dashboard' }
    ];

    if (role === 'admin') {
        items.push(
            { href: '/feedback/admin?status_name=Pending', label: 'New / Pending Feedback', icon: 'inbox', statusName: 'Pending' },
            { href: '/feedback/admin?department=unassigned', label: 'Unassigned Feedback', icon: 'list', unassigned: true },
            { href: '/feedback/admin?status_name=Assigned', label: 'Assign to Department', icon: 'users', statusName: 'Assigned' },
            { href: '/feedback/admin?status_name=Awaiting+Admin+Review', label: 'Awaiting Admin Review', icon: 'eye', statusName: 'Awaiting Admin Review' },
            { href: '/feedback/admin?status_name=Awaiting+Admin+Review', label: 'Approve Resolution', icon: 'check', statusName: 'Awaiting Admin Review' }
        );
    }

    // Faculty-specific sidebar
    if (role === 'faculty') {
        items.push(
            { href: '/feedback/department-inbox', label: 'Assigned Feedback', icon: 'inbox', inbox: true },
            { href: '/feedback/department-inbox?category=faculty_concern', label: 'Faculty Concerns', icon: 'users' },
            { href: '/feedback/department-inbox?category=faculty_suggestion', label: 'Faculty Suggestions', icon: 'list' },
            { href: '/feedback/department-inbox?status_name=Awaiting+Admin+Review', label: 'Submitted to Admin', icon: 'send', statusName: 'Awaiting Admin Review' },
            { href: '/feedback/department-history', label: 'Feedback History', icon: 'chart', history: true }
        );
    } else if (deptStaff) {
        // Existing menu for other department staff
        items.push(
            { href: '/feedback/department-inbox', label: 'Inbox', icon: 'inbox', inbox: true },
            { href: '/feedback/department-inbox?status_name=Under+Review', label: 'Under Review', icon: 'eye', statusName: 'Under Review' },
            { href: '/feedback/department-inbox?status_name=In+Progress', label: 'In Progress', icon: 'list', statusName: 'In Progress' },
            { href: '/feedback/department-inbox?status_name=Awaiting+Admin+Review', label: 'Submit for Final Review', icon: 'send', statusName: 'Awaiting Admin Review' },
            { href: '/feedback/department-history', label: 'Feedback History for Their Department', icon: 'chart', history: true }
        );
    }

    if (role === 'institutional_management') {
        items.push({
            href: '/feedback/management',
            label: 'School overview',
            icon: 'eye'
        });
    }

    if (role === 'admin') {
        items.push({
            href: '/staff/reports',
            label: 'Reports and Analytics',
            icon: 'chart'
        });
    } else if (role === 'institutional_management' || deptStaff) {
        items.push({
            href: '/staff/reports',
            label: 'Reports',
            icon: 'chart'
        });
    }

    if (role === 'admin') {
        items.push({
            href: '/auth/create-staff',
            label: 'Staff accounts',
            icon: 'users'
        });
    }
%>
