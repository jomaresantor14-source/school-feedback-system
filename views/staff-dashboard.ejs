
<%- include('partials/head', { title: 'Dashboard' }) %>
<%- include('partials/staff-open') %>

<div class="page-head page-head--row">
    <div>
        <h1>Welcome back, <%= firstName(me.full_name) %></h1>
        <p class="muted">
            <%= roleLabel(me.role) %><% if (me.department_name) { %>, <%= me.department_name %><% } %>
        </p>
    </div>

    <% if (user.role === 'admin') { %>
        <a class="btn btn--primary" href="/feedback/assign">
            <%- icon('users', 16) %>Department Assignment
        </a>
    <% } else if (DEPT_ROLES.includes(user.role)) { %>
        <a class="btn btn--primary" href="/feedback/department-inbox">
            <%- icon('inbox', 16) %>Open inbox
        </a>
    <% } else { %>
        <a class="btn btn--primary" href="/feedback/submit">
            <%- icon('send', 16) %>Send feedback
        </a>
    <% } %>
</div>

<%- include('partials/flash') %>

<% if (noDepartment) { %>
    <div class="alert alert--error" role="alert">
        <%- icon('alert', 18) %>
        <span>
            Your account has no department yet, so no feedback can be assigned to you.
            Ask an administrator to fix this.
        </span>
    </div>
<% } %>

<p class="section-note"><%= scopeLabel %></p>

<% if (user.role === 'faculty') { %>

    <!-- Faculty dashboard summary -->
    <section class="stat-grid" aria-label="Faculty feedback summary">
        <div class="stat">
            <span class="stat__num"><%= cards.total %></span>
            <span class="stat__label">Assigned Feedback</span>
        </div>

        <div class="stat stat--pending">
            <span class="stat__num"><%= pendingConcernCount %></span>
            <span class="stat__label">Pending Concerns</span>
        </div>

        <div class="stat stat--progress">
            <span class="stat__num"><%= facultyInProgressCount %></span>
            <span class="stat__label">In Progress</span>
        </div>

        <div class="stat">
            <span class="stat__num"><%= facultyResolvedCount %></span>
            <span class="stat__label">Resolved</span>
        </div>
    </section>

    <section class="card card--flush">
        <header class="card__head"><h2>Recent assignments</h2></header>
        <% if (!recentAssignments.length) { %>
            <p class="empty">No feedback has been assigned to your department yet.</p>
        <% } else { %>
            <div class="table-wrap">
                <table class="table table--list">
                    <thead><tr><th>Subject</th><th>Type</th><th>Assigned</th><th>Action</th></tr></thead>
                    <tbody>
                        <% recentAssignments.forEach(item => { %>
                            <tr>
                                <td><a class="row-link" href="/feedback/view/<%= item.id %>"><%= item.subject %></a><span class="sub"><%= formatRef(item.reference_code) %></span></td>
                                <td><%= item.feedback_type %></td>
                                <td class="nowrap"><%= fmtDate(item.changed_at, false) %></td>
                                <td><a class="btn btn--ghost btn--sm" href="/feedback/view/<%= item.id %>">View Details</a></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </section>

    <section class="card card--flush">
        <header class="card__head"><h2>Recent status updates</h2></header>
        <% if (!recentStatusUpdates.length) { %>
            <p class="empty">No status updates have been recorded yet.</p>
        <% } else { %>
            <div class="table-wrap">
                <table class="table table--list">
                    <thead><tr><th>Feedback</th><th>Change</th><th>Date</th><th>Action</th></tr></thead>
                    <tbody>
                        <% recentStatusUpdates.forEach(item => { %>
                            <tr>
                                <td><a class="row-link" href="/feedback/view/<%= item.id %>"><%= item.subject %></a><span class="sub"><%= formatRef(item.reference_code) %></span></td>
                                <td><%= item.old_status ? `${item.old_status} → ${item.new_status}` : `Submitted as ${item.new_status}` %><% if (item.remarks) { %><span class="sub"><%= item.remarks %></span><% } %></td>
                                <td class="nowrap"><%= fmtDate(item.changed_at, false) %></td>
                                <td><a class="btn btn--ghost btn--sm" href="/feedback/view/<%= item.id %>">View Details</a></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </section>

    <!-- Faculty Concerns -->
    <section class="card card--flush">
        <header class="card__head">
            <h2>Faculty Concerns</h2>
        </header>

        <% if (!facultyConcerns || facultyConcerns.length === 0) { %>
            <p class="empty">No faculty concerns found.</p>
        <% } else { %>
            <div class="table-wrap">
                <table class="table table--list">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Reference Number</th>
                            <th>Date Submitted</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% facultyConcerns.forEach(item => { %>
                            <tr>
                                <td>
                                    <a class="row-link"
                                       href="/feedback/view/<%= item.id %>">
                                        <%= item.subject %>
                                    </a>
                                </td>
                                <td><%= item.category_name %></td>
                                <td>
                                    <%- include('partials/status-badge', {
                                        badgeStatus: item.status_name
                                    }) %>
                                </td>
                                <td><%= formatRef(item.reference_code) %></td>
                                <td class="nowrap"><%= fmtDate(item.created_at, false) %></td>
                                <td>
                                    <a class="btn btn--ghost btn--sm"
                                       href="/feedback/view/<%= item.id %>">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </section>

    <!-- Faculty Suggestions -->
    <section class="card card--flush">
        <header class="card__head">
            <h2>Faculty Suggestions</h2>
        </header>

        <% if (!facultySuggestions || facultySuggestions.length === 0) { %>
            <p class="empty">No faculty suggestions found.</p>
        <% } else { %>
            <div class="table-wrap">
                <table class="table table--list">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Reference Number</th>
                            <th>Date Submitted</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% facultySuggestions.forEach(item => { %>
                            <tr>
                                <td>
                                    <a class="row-link"
                                       href="/feedback/view/<%= item.id %>">
                                        <%= item.subject %>
                                    </a>
                                </td>
                                <td><%= item.category_name %></td>
                                <td>
                                    <%- include('partials/status-badge', {
                                        badgeStatus: item.status_name
                                    }) %>
                                </td>
                                <td><%= formatRef(item.reference_code) %></td>
                                <td class="nowrap"><%= fmtDate(item.created_at, false) %></td>
                                <td>
                                    <a class="btn btn--ghost btn--sm"
                                       href="/feedback/view/<%= item.id %>">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </section>

    <!-- Submitted to Admin -->
    <section class="card card--flush">
        <header class="card__head">
            <h2>Submitted to Admin</h2>
        </header>

        <% if (!submittedToAdmin || submittedToAdmin.length === 0) { %>
            <p class="empty">
                No feedback has been submitted for admin review yet.
            </p>
        <% } else { %>
            <div class="table-wrap">
                <table class="table table--list">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Reference Number</th>
                            <th>Date Forwarded</th>
                            <th>Department action</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% submittedToAdmin.forEach(item => { %>
                            <tr>
                                <td>
                                    <a class="row-link"
                                       href="/feedback/view/<%= item.id %>">
                                        <%= item.subject %>
                                    </a>
                                </td>
                                <td><%= item.category_name %></td>
                                <td>
                                    <%- include('partials/status-badge', {
                                        badgeStatus: item.status_name
                                    }) %>
                                </td>
                                <td><%= formatRef(item.reference_code) %></td>
                                <td class="nowrap"><%= item.date_forwarded ? fmtDate(item.date_forwarded, false) : '—' %></td>
                                <td><%= item.latest_remarks || '—' %></td>
                                <td>
                                    <a class="btn btn--ghost btn--sm"
                                       href="/feedback/view/<%= item.id %>">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </section>

<% } else if (departmentDashboard) { %>

    <section class="stat-grid stat-grid--department" aria-label="Department feedback summary">
        <div class="stat">
            <span class="stat__num"><%= cards.total %></span>
            <span class="stat__label">Total Feedback</span>
        </div>

        <div class="stat stat--pending">
            <span class="stat__num"><%= cards.pendingAssigned %></span>
            <span class="stat__label">Pending / Assigned</span>
        </div>

        <div class="stat">
            <span class="stat__num"><%= cards.underReview %></span>
            <span class="stat__label">Under Review</span>
        </div>

        <div class="stat stat--progress">
            <span class="stat__num"><%= cards.inProgress %></span>
            <span class="stat__label">In Progress</span>
        </div>

        <div class="stat">
            <span class="stat__num"><%= cards.awaitingAdminReview %></span>
            <span class="stat__label">Awaiting Admin Review</span>
        </div>

        <div class="stat stat--resolved">
            <span class="stat__num"><%= cards.resolved %></span>
            <span class="stat__label">Resolved</span>
        </div>
    </section>

    <% if (departmentWorkflowShortcuts) { %>
        <section class="card" aria-labelledby="department-workflow-title">
            <header class="card__head">
                <h2 id="department-workflow-title">Department workflow</h2>
                <a href="/feedback/department-inbox">Open full inbox</a>
            </header>
            <p class="muted">Open the correct queue to review assigned feedback and continue department actions.</p>
            <div class="filters__actions">
                <a class="btn btn--ghost" href="/feedback/department-inbox">
                    Inbox <span class="badge"><%= cards.pendingAssigned %></span>
                </a>
                <a class="btn btn--ghost" href="/feedback/department-inbox?status_name=Under+Review">
                    Under Review <span class="badge"><%= cards.underReview %></span>
                </a>
                <a class="btn btn--ghost" href="/feedback/department-inbox?status_name=In+Progress">
                    In Progress <span class="badge"><%= cards.inProgress %></span>
                </a>
                <a class="btn btn--ghost" href="/feedback/department-inbox?status_name=Awaiting+Admin+Review">
                    Submit for Final Review <span class="badge"><%= cards.awaitingAdminReview %></span>
                </a>
                <a class="btn btn--ghost" href="/feedback/department-history">Department History</a>
                <a class="btn btn--ghost" href="/staff/reports">Department Reports</a>
            </div>
        </section>
    <% } %>

    <section class="card card--flush">
        <header class="card__head">
            <h2>Feedback for <%= me.department_name || 'your department' %></h2>
        </header>

        <% if (!departmentFeedback || departmentFeedback.rows.length === 0) { %>
            <p class="empty">No feedback is assigned to your department yet.</p>
        <% } else { %>
            <div class="table-wrap">
                <table class="table table--list">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Reference Number</th>
                            <th>Date Submitted</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% departmentFeedback.rows.forEach(item => { %>
                            <tr>
                                <td>
                                    <a class="row-link" href="/feedback/view/<%= item.id %>">
                                        <%= item.subject %>
                                    </a>
                                </td>
                                <td><%= item.category_name %></td>
                                <td>
                                    <%- include('partials/status-badge', {
                                        badgeStatus: item.status_name
                                    }) %>
                                </td>
                                <td><%= formatRef(item.reference_code) %></td>
                                <td class="nowrap"><%= fmtDate(item.created_at, false) %></td>
                                <td>
                                    <a class="btn btn--ghost btn--sm"
                                       href="/feedback/view/<%= item.id %>">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <% if (departmentFeedback.pages > 1) { %>
                <nav class="pager" aria-label="Department feedback pages">
                    <% if (departmentFeedback.page > 1) { %>
                        <a class="btn btn--ghost btn--sm"
                           href="<%= departmentPageUrl(departmentFeedback.page - 1) %>">
                            Previous
                        </a>
                    <% } else { %>
                        <span></span>
                    <% } %>

                    <span class="pager__info">
                        Page <%= departmentFeedback.page %> of <%= departmentFeedback.pages %>
                    </span>

                    <% if (departmentFeedback.page < departmentFeedback.pages) { %>
                        <a class="btn btn--ghost btn--sm"
                           href="<%= departmentPageUrl(departmentFeedback.page + 1) %>">
                            Next
                        </a>
                    <% } else { %>
                        <span></span>
                    <% } %>
                </nav>
            <% } %>
        <% } %>
    </section>

<% } else { %>

    <% if (user.role === 'admin') { %>
        <section class="stat-grid" aria-label="System feedback summary">
            <div class="stat">
                <span class="stat__num"><%= cards.total %></span>
                <span class="stat__label">Total Feedback</span>
            </div>
            <div class="stat stat--pending">
                <span class="stat__num"><%= cards.pending %></span>
                <span class="stat__label">Pending</span>
            </div>
            <div class="stat stat--progress">
                <span class="stat__num"><%= cards.inProgress %></span>
                <span class="stat__label">In Progress</span>
            </div>
            <div class="stat">
                <span class="stat__num"><%= cards.awaitingAdminReview %></span>
                <span class="stat__label">Awaiting Admin Review</span>
            </div>
            <div class="stat stat--resolved">
                <span class="stat__num"><%= cards.resolved %></span>
                <span class="stat__label">Resolved</span>
            </div>
        </section>

        <section class="card card--flush">
            <header class="card__head">
                <h2>Recent feedback activity</h2>
                <a href="/feedback/admin">View all feedback</a>
            </header>
            <% if (!recentActivity.length) { %>
                <p class="empty">No feedback activity has been recorded yet.</p>
            <% } else { %>
                <div class="table-wrap">
                    <table class="table">
                        <thead><tr><th>Feedback</th><th>Activity</th><th>By</th><th>Date</th><th>Action</th></tr></thead>
                        <tbody>
                            <% recentActivity.forEach(item => { %>
                                <tr>
                                    <td>
                                        <a class="row-link" href="/feedback/view/<%= item.id %>"><%= item.subject %></a>
                                        <span class="sub"><%= formatRef(item.reference_code) %></span>
                                    </td>
                                    <td><%= item.activity %></td>
                                    <td><%= item.actor %></td>
                                    <td class="nowrap"><%= fmtDate(item.activity_at, false) %></td>
                                    <td><a class="btn btn--ghost btn--sm" href="/feedback/view/<%= item.id %>">View Details</a></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>
    <% } else { %>
        <section class="stat-grid" aria-label="Summary">
            <div class="stat">
                <span class="stat__num"><%= cards.total %></span>
                <span class="stat__label">Total</span>
            </div>

            <div class="stat stat--pending">
                <span class="stat__num"><%= cards.pending %></span>
                <span class="stat__label">Pending</span>
            </div>

            <div class="stat stat--progress">
                <span class="stat__num"><%= cards.active %></span>
                <span class="stat__label">Active or awaiting admin review</span>
            </div>

            <div class="stat stat--resolved">
                <span class="stat__num"><%= cards.resolved %></span>
                <span class="stat__label">Resolved</span>
            </div>
        </section>

        <section class="card card--flush">
            <header class="card__head">
                <h2><%= attention.title %></h2>

                <% if (attention.link) { %>
                    <a href="<%= attention.link.href %>">
                        <%= attention.link.text %>
                    </a>
                <% } %>
            </header>

            <% if (attention.rows.length === 0) { %>
                <p class="empty">Nothing here right now.</p>
            <% } else { %>
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Subject</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Submitted</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% attention.rows.forEach(item => {
                                const canOpen =
                                    user.role === 'institutional_management' ||
                                    DEPT_ROLES.includes(user.role);

                                const href = canOpen
                                    ? '/feedback/view/' + item.id
                                    : '/feedback/track?code=' + encodeURIComponent(item.reference_code);
                            %>
                                <tr>
                                    <td>
                                        <a class="row-link" href="<%= href %>">
                                            <%= item.subject %>
                                        </a>
                                        <span class="sub">
                                            <%= formatRef(item.reference_code) %>
                                        </span>
                                    </td>
                                    <td><%= item.category_name %></td>
                                    <td>
                                        <%- include('partials/status-badge', {
                                            badgeStatus: item.status_name
                                        }) %>
                                    </td>
                                    <td class="nowrap"><%= fmtDate(item.created_at, false) %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>
    <% } %>

<% } %>

<%- include('partials/staff-close') %>
<%- include('partials/foot') %>
