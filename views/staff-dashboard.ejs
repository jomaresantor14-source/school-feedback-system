<%- include('partials/head', { title: 'Dashboard' }) %>
<%- include('partials/staff-open') %>

<div class="page-head page-head--row">
    <div>
        <h1>Welcome back, <%= firstName(me.full_name) %></h1>
        <p class="muted">
            <%= roleLabel(me.role) %><% if (me.department_name) { %>, <%= me.department_name %><% } %>
        </p>
    </div>
    <% if (user.role === 'admin') { %>
        <a class="btn btn--primary" href="/feedback/admin"><%- icon('list', 16) %>Manage feedback</a>
    <% } else if (DEPT_ROLES.includes(user.role)) { %>
        <a class="btn btn--primary" href="/feedback/department-inbox"><%- icon('inbox', 16) %>Open inbox</a>
    <% } else { %>
        <a class="btn btn--primary" href="/feedback/submit"><%- icon('send', 16) %>Send feedback</a>
    <% } %>
</div>

<%- include('partials/flash') %>

<% if (noDepartment) { %>
    <div class="alert alert--error" role="alert">
        <%- icon('alert', 18) %>
        <span>Your account has no department yet, so no feedback can be assigned to you. Ask an administrator to fix this.</span>
    </div>
<% } %>

<p class="section-note"><%= scopeLabel %></p>
<section class="stat-grid" aria-label="Summary">
    <div class="stat"><span class="stat__num"><%= cards.total %></span><span class="stat__label">Total</span></div>
    <div class="stat stat--pending"><span class="stat__num"><%= cards.pending %></span><span class="stat__label">Pending</span></div>
    <div class="stat stat--progress"><span class="stat__num"><%= cards.active %></span><span class="stat__label">Under review or in progress</span></div>
    <div class="stat stat--resolved"><span class="stat__num"><%= cards.resolved %></span><span class="stat__label">Resolved</span></div>
</section>

<section class="card card--flush">
    <header class="card__head">
        <h2><%= attention.title %></h2>
        <% if (attention.link) { %><a href="<%= attention.link.href %>"><%= attention.link.text %></a><% } %>
    </header>

    <% if (attention.rows.length === 0) { %>
        <p class="empty">Nothing here right now.</p>
    <% } else { %>
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>Subject</th><th>Category</th><th>Status</th><th>Submitted</th></tr></thead>
                <tbody>
                    <% attention.rows.forEach(item => {
                        const canOpen = user.role === 'admin' || user.role === 'institutional_management' || DEPT_ROLES.includes(user.role);
                        const href = canOpen ? '/feedback/view/' + item.id : '/feedback/track?code=' + item.reference_code; %>
                        <tr>
                            <td>
                                <a class="row-link" href="<%= href %>"><%= item.subject %></a>
                                <span class="sub"><%= formatRef(item.reference_code) %></span>
                            </td>
                            <td><%= item.category_name %></td>
                            <td><%- include('partials/status-badge', { badgeStatus: item.status_name }) %></td>
                            <td class="nowrap"><%= fmtDate(item.created_at, false) %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</section>

<%- include('partials/staff-close') %>
<%- include('partials/foot') %>
