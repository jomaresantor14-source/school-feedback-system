<%- include('partials/head', { title: 'Department feedback history' }) %>
<%- include('partials/staff-open') %>

<div class="page-head">
    <h1>Feedback History for Your Department</h1>
    <p class="muted">Status changes, department notes, and final administrator responses for feedback assigned to your department.</p>
</div>

<% if (rows.length === 0) { %>
    <section class="card empty-card">
        <h2>No department history yet</h2>
        <p class="muted">Feedback assigned to your department will appear here.</p>
    </section>
<% } else { %>
    <p class="result-count"><%= rows.length %> <%= rows.length === 1 ? 'submission' : 'submissions' %></p>
    <section class="card card--flush">
        <div class="table-wrap">
            <table class="table table--list">
                <thead>
                    <tr>
                        <th>Subject</th>
                        <th>Reference</th>
                        <th>Previous status</th>
                        <th>Current status</th>
                        <th>Date submitted</th>
                        <th>Last updated</th>
                        <th>Department remarks</th>
                        <th>Administrator response</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% rows.forEach(item => { %>
                        <tr>
                            <td><a class="row-link" href="/feedback/view/<%= item.id %>"><%= item.subject %></a></td>
                            <td><%= formatRef(item.reference_code) %></td>
                            <td><%= item.previous_status || '—' %></td>
                            <td><%- include('partials/status-badge', { badgeStatus: item.current_status }) %></td>
                            <td class="nowrap"><%= fmtDate(item.created_at, false) %></td>
                            <td class="nowrap"><%= fmtDate(item.last_updated_at || item.created_at, false) %></td>
                            <td><%= item.department_remarks || '—' %></td>
                            <td><%= item.current_status === 'Resolved' ? (item.admin_response || 'Resolved by administrator.') : '—' %></td>
                            <td><a class="btn btn--ghost btn--sm" href="/feedback/view/<%= item.id %>">View History</a></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </section>
<% } %>

<%- include('partials/staff-close') %>
<%- include('partials/foot') %>
