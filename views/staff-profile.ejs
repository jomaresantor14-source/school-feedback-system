<%- include('partials/head', { title: 'My Profile' }) %>
<%- include('partials/staff-open') %>

<div class="profile-page">
    <div class="page-head profile-page__head">
        <div>
            <p class="profile-eyebrow">ACCOUNT SETTINGS</p>
            <h1>My Profile</h1>
            <p class="muted">Manage your personal details and account security.</p>
        </div>
        <% if (!editMode) { %>
            <a class="btn btn--primary" href="/staff/profile?edit=1">
                <%- icon('user', 16) %> Edit Profile
            </a>
        <% } %>
    </div>

    <%- include('partials/flash') %>

    <% if (error) { %>
        <div class="alert alert--error" role="alert">
            <%- icon('alert', 18) %><span><%= error %></span>
        </div>
    <% } %>

    <section class="profile-hero card" aria-label="Faculty identity">
        <div class="profile-hero__identity">
            <span class="profile-avatar" aria-hidden="true"><%= initials(profile.full_name) %></span>
            <div class="profile-hero__text">
                <h2><%= profile.full_name %></h2>
                <p><%= profile.email %></p>
                <div class="profile-badges">
                    <span class="profile-badge"><%- icon('user', 14) %> Faculty</span>
                    <span class="profile-department"><%= profile.department_name || 'Department not assigned' %></span>
                </div>
            </div>
        </div>
        <div class="profile-hero__meta">
            <span class="profile-meta-label">Department</span>
            <strong><%= profile.department_name || 'Not assigned' %></strong>
        </div>
    </section>

    <div class="profile-grid">
        <section class="card profile-card">
            <header class="profile-card__head">
                <span class="profile-card__icon"><%- icon('user', 18) %></span>
                <div>
                    <h2>Personal Information</h2>
                    <p class="muted">Your account contact details.</p>
                </div>
            </header>

            <% if (editMode) { %>
                <form class="form profile-form" action="/staff/profile" method="POST">
                    <%- include('partials/csrf') %>
                    <div class="field">
                        <label for="full_name">Full name</label>
                        <input class="input" type="text" id="full_name" name="full_name" maxlength="150" autocomplete="name" value="<%= values.full_name %>" required>
                    </div>
                    <div class="field">
                        <label>Email address</label>
                        <input class="input" type="email" value="<%= profile.email %>" readonly aria-describedby="email-help">
                        <p class="hint" id="email-help">Contact an administrator if your email needs to be changed.</p>
                    </div>
                    <div class="profile-form__actions">
                        <button type="submit" class="btn btn--primary" data-loading-text="Saving...">Save Changes</button>
                        <a class="btn btn--ghost" href="/staff/profile">Cancel</a>
                    </div>
                </form>
            <% } else { %>
                <dl class="profile-details">
                    <div>
                        <dt>Full name</dt>
                        <dd><%= profile.full_name %></dd>
                    </div>
                    <div>
                        <dt>Email address</dt>
                        <dd><%= profile.email %></dd>
                    </div>
                </dl>
            <% } %>
        </section>

        <section class="card profile-card">
            <header class="profile-card__head">
                <span class="profile-card__icon"><%- icon('inbox', 18) %></span>
                <div>
                    <h2>Employment &amp; Department</h2>
                    <p class="muted">Your role and assigned department.</p>
                </div>
            </header>
            <dl class="profile-details">
                <div>
                    <dt>Role</dt>
                    <dd><span class="profile-role"><%= roleLabel(profile.role) %></span></dd>
                </div>
                <div>
                    <dt>Assigned department</dt>
                    <dd><%= profile.department_name || 'Not assigned' %></dd>
                </div>
            </dl>
            <p class="profile-note">Role and department assignments are managed by an administrator.</p>
        </section>

        <section class="card profile-card">
            <header class="profile-card__head">
                <span class="profile-card__icon"><%- icon('chart', 18) %></span>
                <div>
                    <h2>Account Information</h2>
                    <p class="muted">Details about your School Feedback account.</p>
                </div>
            </header>
            <dl class="profile-details">
                <div>
                    <dt>Account created</dt>
                    <dd><%= fmtDate(profile.created_at, false) %></dd>
                </div>
                <div>
                    <dt>Account type</dt>
                    <dd>Faculty account</dd>
                </div>
            </dl>
        </section>

        <section class="card profile-card profile-card--security">
            <header class="profile-card__head">
                <span class="profile-card__icon"><%- icon('lock', 18) %></span>
                <div>
                    <h2>Security</h2>
                    <p class="muted">Change your sign-in password.</p>
                </div>
            </header>
            <form class="form profile-form" action="/staff/profile/password" method="POST">
                <%- include('partials/csrf') %>
                <div class="field">
                    <label for="current_password">Current password</label>
                    <input class="input" type="password" id="current_password" name="current_password" autocomplete="current-password" required>
                </div>
                <div class="field">
                    <label for="new_password">New password</label>
                    <input class="input" type="password" id="new_password" name="new_password" minlength="12" autocomplete="new-password" required>
                    <p class="hint">Use at least 12 characters.</p>
                </div>
                <div class="field">
                    <label for="confirm_password">Confirm new password</label>
                    <input class="input" type="password" id="confirm_password" name="confirm_password" minlength="12" autocomplete="new-password" required>
                </div>
                <button type="submit" class="btn btn--ghost profile-password-submit" data-loading-text="Updating password...">Change Password</button>
            </form>
        </section>
    </div>
</div>

<%- include('partials/staff-close') %>
<%- include('partials/foot') %>
