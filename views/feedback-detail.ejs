<%- include('partials/head', { title: feedback.subject }) %>
<%- include('partials/staff-open') %>

<a class="back-link" href="<%= back.href %>"><%- icon('back', 16) %><%= back.text %></a>

<div class="page-head page-head--row">
    <div>
        <h1><%= feedback.subject %></h1>
        <p class="muted">Reference <%= formatRef(feedback.reference_code) %></p>
    </div>
    <%- include('partials/status-badge', { badgeStatus: feedback.status_name }) %>
</div>

<%- include('partials/flash') %>

<div class="detail">
    <div class="detail__main">
        <section class="card">
            <h2>What was submitted</h2>
            <p class="prose"><%= feedback.description %></p>
        </section>

        <section class="card">
            <h2>Activity</h2>
            <ol class="timeline">
                <% events.forEach(event => { %>
                    <li class="timeline__item">
                        <span class="timeline__dot <%= event.kind === 'assignment' ? 'timeline__dot--assign' : (event.status ? 'timeline__dot--' + statusClass(event.status) : '') %>"></span>
                        <div>
                            <p class="timeline__title"><%= event.title %></p>
                            <p class="timeline__meta"><%= event.by ? event.by + ', ' : '' %><%= fmtDate(event.at) %></p>
                            <% if (event.remarks) { %><p class="timeline__note"><%= event.remarks %></p><% } %>
                        </div>
                    </li>
                <% }) %>
            </ol>
        </section>
    </div>

    <aside class="detail__side">
        <section class="card">
            <h2>Details</h2>
            <dl class="facts facts--stack">
                <div><dt>Submitted by</dt><dd><%= submitter %><% if (submitterEmail) { %><span class="sub"><%= submitterEmail %></span><% } %></dd></div>
                <div><dt>Type</dt><dd><%= feedback.feedback_type %></dd></div>
                <div><dt>Category</dt><dd><%= feedback.category_name %></dd></div>
                <div><dt>Department</dt><dd><%= feedback.department_name || 'Not assigned' %></dd></div>
                <div><dt>Submitted</dt><dd><%= fmtDate(feedback.created_at) %></dd></div>
            </dl>
        </section>

        <% if (canUpdate && user.role !== 'admin' && feedback.status_name !== 'Awaiting Admin Review') { %>
            <section class="card">
                <h2>Department progress</h2>
                <form class="form" action="/feedback/view/<%= feedback.id %>/status" method="POST">
                    <%- include('partials/csrf') %>
                    <div class="field">
                        <label for="status_id">Status</label>
                        <select class="input" id="status_id" name="status_id" required>
                            <%
                                const isAdmin = user.role === 'admin';
                                let allowedStatusNames = [feedback.status_name];
                                if (isAdmin && feedback.status_name === 'Awaiting Admin Review') {
                                    allowedStatusNames = [
                                        'Awaiting Admin Review',
                                        'Under Review',
                                        'In Progress',
                                        'Resolved'
                                    ];
                                } else if (!isAdmin) {
                                    const transitions = {
                                        Assigned: ['Under Review'],
                                        'Under Review': ['Under Review', 'In Progress'],
                                        'In Progress': ['In Progress'],
                                        'Returned for Further Action': ['Returned for Further Action', 'Under Review']
                                    };
                                    allowedStatusNames = transitions[feedback.status_name] || [];
                                    if (!allowedStatusNames.includes(feedback.status_name)) {
                                        allowedStatusNames.unshift(feedback.status_name);
                                    }
                                }
                                const availableStatuses = statuses.filter(s =>
                                    allowedStatusNames.includes(s.status_name)
                                );
                            %>
                            <% availableStatuses.forEach(s => { %>
                                <option
                                    value="<%= s.id %>"
                                    <%= Number(s.id) === Number(feedback.status_id) ? 'selected' : '' %>>
                                    <%= s.status_name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="field">
                        <label for="remarks">Internal department note <span class="optional">(optional)</span></label>
                        <textarea class="input" id="remarks" name="remarks" rows="4" maxlength="1000" placeholder="Add an internal progress note."></textarea>
                        <p class="hint">Internal notes are visible only to authorized staff.</p>
                    </div>
                    <button type="submit" class="btn btn--primary btn--block" data-loading-text="Saving...">Save progress</button>
                </form>
            </section>
        <% } %>

        <% if (canUpdate && user.role !== 'admin' && feedback.status_name === 'In Progress') { %>
            <section class="card">
                <h2>Submit action report</h2>
                <p class="muted">Describe the action taken and findings. Once submitted, the report is locked until Admin review.</p>
                <form class="form" action="/feedback/view/<%= feedback.id %>/report" method="POST" data-confirm="Submit this action report to the Admin? You cannot edit it until it is returned.">
                    <%- include('partials/csrf') %>
                    <div class="field">
                        <label for="report-remarks">Action taken and findings</label>
                        <textarea class="input" id="report-remarks" name="remarks" rows="5" maxlength="1000" required placeholder="Summarize the actions taken and the outcome."></textarea>
                    </div>
                    <button type="submit" class="btn btn--primary btn--block" data-loading-text="Submitting report...">Submit to Admin</button>
                </form>
            </section>
        <% } %>

        <% if (user.role === 'admin' && feedback.status_name === 'Awaiting Admin Review') { %>
            <section class="card">
                <h2>Review department report</h2>
                <p class="muted">Approve the reported resolution or return it to the department with instructions.</p>
                <form class="form" action="/feedback/view/<%= feedback.id %>/review" method="POST" data-confirm="Approve this report and mark the feedback Resolved?">
                    <%- include('partials/csrf') %>
                    <div class="field">
                        <label for="review-remarks">Administrator review remarks / final response</label>
                        <textarea class="input" id="review-remarks" name="remarks" rows="5" maxlength="1000" required placeholder="Provide a final response or explain what further action is required."></textarea>
                    </div>
                    <button type="submit" name="decision" value="resolve" class="btn btn--primary btn--block" data-loading-text="Approving...">Approve &amp; Resolve</button>
                    <button type="submit" name="decision" value="return" class="btn btn--ghost btn--block" formnovalidate data-confirm="Return this report to the department for further action?" data-loading-text="Returning...">Return for Further Action</button>
                </form>
            </section>
        <% } %>

        <% if (canAssign) { %>
            <section class="card">
                <h2>Assign department</h2>
                <form class="form" action="/feedback/view/<%= feedback.id %>/assign" method="POST" data-confirm="Assign this submission to the selected department?">
                    <%- include('partials/csrf') %>
                    <div class="field">
                        <label for="department_id">Department</label>
                        <select class="input" id="department_id" name="department_id" required>
                            <option value="">Choose a department</option>
                            <% departments.forEach(d => { %>
                                <option value="<%= d.id %>" <%= Number(feedback.assigned_department_id) === d.id ? 'selected' : '' %>><%= d.department_name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="field">
                        <label for="assignment_remarks">Assignment remarks <span class="optional">(optional, staff-only)</span></label>
                        <textarea class="input" id="assignment_remarks" name="assignment_remarks" rows="3" maxlength="1000" placeholder="Add routing instructions for the department."></textarea>
                    </div>
                    <button type="submit" class="btn btn--ghost btn--block" data-loading-text="Assigning...">Assign</button>
                </form>
            </section>
        <% } %>

        <% if (!canUpdate) { %>
            <p class="muted read-only"><%- icon('lock', 14) %> You have read-only access to this record.</p>
        <% } %>
    </aside>
</div>

<%- include('partials/staff-close') %>
<%- include('partials/foot') %>
